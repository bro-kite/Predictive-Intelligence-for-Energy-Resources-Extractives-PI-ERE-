# PI-ERE Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# Data Source API Keys
# ============================================================================

# ACLED API - Get your key from https://developer.acleddata.com
ACLED_API_KEY=your_acled_api_key_here
ACLED_EMAIL=your_email@example.com

# GDELT (usually no key required, but rate limits may apply)
GDELT_API_KEY=

# World Bank API (optional, public data is usually accessible without key)
WORLD_BANK_API_KEY=

# FRED (Federal Reserve Economic Data) - Get key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ============================================================================
# Database Connections
# ============================================================================

# PostgreSQL (for structured data storage)
POSTGRES_URL=postgresql://user:password@localhost:5432/pi_ere

# Qdrant (vector database for embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Alternative: pgvector (if using PostgreSQL with vector extension)
PGVECTOR_URL=postgresql://user:password@localhost:5432/pi_ere_vectors

# ============================================================================
# File Paths & Storage
# ============================================================================

# Data directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EMBEDDINGS_DIR=./data/embeddings

# Model directories
MODEL_DIR=./models
CHECKPOINT_DIR=./models/checkpoints
LOGS_DIR=./logs

# ============================================================================
# Compute Settings
# ============================================================================

# Device: 'cpu', 'cuda', 'cuda:0', 'mps' (for Apple Silicon)
DEVICE=cpu

# Number of workers for data loading
NUM_WORKERS=4

# Batch sizes
TRAIN_BATCH_SIZE=32
INFERENCE_BATCH_SIZE=64

# ============================================================================
# Model Settings
# ============================================================================

# Hugging Face token (for gated models)
HF_TOKEN=your_huggingface_token_here

# Experiment tracking (optional)
WANDB_API_KEY=
WANDB_PROJECT=pi-ere
WANDB_ENTITY=

MLFLOW_TRACKING_URI=http://localhost:5000

# ============================================================================
# Client-Specific (Production Only)
# ============================================================================

# Internal incident database
INTERNAL_DB_URL=

# Supply chain API
SUPPLY_CHAIN_API_URL=
SUPPLY_CHAIN_API_KEY=

# Satellite imagery providers
PLANET_API_KEY=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ============================================================================
# Security & Monitoring
# ============================================================================

# Encryption keys (for production)
DATA_ENCRYPTION_KEY=
SECRET_KEY=

# Monitoring & Alerting
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable specific features
ENABLE_CACHE=true
ENABLE_MONITORING=true
ENABLE_EXPLANATIONS=true
DEBUG_MODE=false

# ============================================================================
# Rate Limiting & Quotas
# ============================================================================

# API rate limits (requests per minute)
ACLED_RATE_LIMIT=60
GDELT_RATE_LIMIT=100
WORLD_BANK_RATE_LIMIT=120

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
